# Optional: leave credentials empty for the no-cost example experience.
# Never prefix these variables with NEXT_PUBLIC_. Do not commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
# Choose a voice ID from your own ElevenLabs account.
ELEVENLABS_VOICE_ID=
