{
  "name": "tour-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "^18.2.0",
    "react-dom": "^19.3.0",
    "react-draggable": "^4.4.6",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^19",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.27",
    "prettier": "3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "overrides": {
    "@humanfs/node": "^0.16.8",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^5.0.0": "^5.0.12",
    "flatted": "^3.4.2",
    "js-yaml": "^4.3.2",
    "minimatch@^3.0.0": "^3.1.4",
    "minimatch@^10.0.0": "^10.2.3",
    "nanoid@^3.0.0": "^3.3.18",
    "picomatch@^2.0.0": "^2.3.2",
    "picomatch@^4.0.0": "^4.0.4",
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  }
}
